FROM python:3.12-slim

# Install the Hugging Face CLI
RUN pip install --no-cache-dir "huggingface_hub[cli]"

# Set a working directory inside the container
WORKDIR /workspace

# Run your download command when the container starts
# Note: /workspace/FLAN is used as the target inside the container
CMD ["hf", "download", "Open-Orca/FLAN", "--repo-type", "dataset", "--local-dir", "/workspace/FLAN"]